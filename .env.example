# Copy to .env (never commit .env). Production secrets are injected by the
# deployment environment, not by a file in the repository.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.development
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=America/Fortaleza

# --- Database (PostgreSQL + PostGIS) ---
# Local dev uses the native PostgreSQL (ADR 0002). The engine becomes PostGIS in M2.
DATABASE_URL=postgres://ondetabarato:change-me@localhost:5432/ondetabarato
POSTGRES_DB=ondetabarato
POSTGRES_USER=ondetabarato
POSTGRES_PASSWORD=change-me

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- Auth (JWT) ---
JWT_SECRET=change-me
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14

# --- CORS ---
CORS_ALLOWED_ORIGINS=

# --- AI / OCR (provider abstraction; see docs/AI_GOVERNANCE.md) ---
AI_PROVIDER=none
AI_API_KEY=
OCR_PROVIDER=none

# --- Object storage for evidence images ---
STORAGE_BACKEND=local
STORAGE_BUCKET=
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
